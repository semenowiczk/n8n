# Archiwum Telegram (uniwersalne)
GDRIVE_FOLDER_TELEGRAM=FOLDER_ID_PLACEHOLDER_TELEGRAM        # Archiwum_Telegram
GDRIVE_FOLDER_TELEGRAM_01=FOLDER_ID_PLACEHOLDER_TELEGRAM_01  # Obrazy
GDRIVE_FOLDER_TELEGRAM_02=FOLDER_ID_PLACEHOLDER_TELEGRAM_02  # Dokumenty
GDRIVE_FOLDER_TELEGRAM_03=FOLDER_ID_PLACEHOLDER_TELEGRAM_03  # Filmy
GDRIVE_FOLDER_TELEGRAM_04=FOLDER_ID_PLACEHOLDER_TELEGRAM_04  # Audio

# ============================================
# n8n CONFIGURATION
# ============================================
N8N_HOST=0.0.0.0
N8N_PORT=5678
N8N_PROTOCOL=https
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me-please

# Webhook URL (zostanie wygenerowany po aktywacji workflow)
WEBHOOK_URL=https://your-domain.com/webhook/k2bud-agent

# ============================================
# ADVANCED OPTIONS (opcjonalnie)
# ============================================

# Context Manager
BUFFER_TIMEOUT_MS=60000                      # 60s timeout dla bufora tekstu
MAX_CONVERSATION_HISTORY=10                  # Max wiadomości w historii
MAX_OPERATION_HISTORY=50                     # Max operacji w historii

# File limits
MAX_FILE_SIZE_MB=100                         # Max rozmiar pliku (MB)

# Logging
LOG_LEVEL=info                               # debug, info, warn, error
LOG_FILE=/var/log/n8n/k2bud.log

# ============================================
# INSTRUKCJE
# ============================================
# 1. Skopiuj ten plik jako .env: cp .env.example .env
# 2. Uzupełnij wszystkie wartości PLACEHOLDER rzeczywistymi danymi
# 3. Nigdy nie commituj .env do git!
# 4. Sprawdź SETUP_INSTRUCTIONS.md dla szczegółów
