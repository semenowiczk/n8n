GDRIVE_FOLDER_04_01=FOLDER_ID_PLACEHOLDER_04_01              # Umowy
GDRIVE_FOLDER_04_02=FOLDER_ID_PLACEHOLDER_04_02              # Sprawy_sadowe
GDRIVE_FOLDER_04_03=FOLDER_ID_PLACEHOLDER_04_03              # Opinie_prawne

