# ============================================
# K2BUD UNIFIED AGENT - CONFIGURATION
# ============================================

# ============================================
# TELEGRAM BOT
# ============================================
# Uzyskaj token od @BotFather w Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID (opcjonalnie - dla whitelist)
# Uzyskaj przez: https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=123456789

# ============================================
# ANTHROPIC CLAUDE API
# ============================================
# Uzyskaj klucz na: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# Modele (opcjonalnie - domyślne w unified_ai_handler.js)
# MODEL_CLASSIFICATION=claude-3-5-haiku-20241022
# MODEL_CHAT=claude-3-5-sonnet-20241022

# ============================================
# GOOGLE DRIVE FOLDER IDs
# ============================================
# Uzyskaj ID folderów z URL: https://drive.google.com/drive/folders/FOLDER_ID
# Format ID: ciąg znaków alfanumerycznych (np. 1a2B3c4D5e6F7g8H9i0J)

# Główne foldery
GDRIVE_FOLDER_00=FOLDER_ID_PLACEHOLDER_00                    # 00_DO_SORTOWANIA
GDRIVE_FOLDER_01=FOLDER_ID_PLACEHOLDER_01                    # 01_ADMINISTRACJA
GDRIVE_FOLDER_02=FOLDER_ID_PLACEHOLDER_02                    # 02_KSIĘGOWOŚĆ
GDRIVE_FOLDER_03=FOLDER_ID_PLACEHOLDER_03                    # 03_PROJEKTY

# Administracja - podfoldery
