GDRIVE_FOLDER_01_02=FOLDER_ID_PLACEHOLDER_01_02              # Pelnomocnictwa
GDRIVE_FOLDER_01_03=FOLDER_ID_PLACEHOLDER_01_03              # Uchwaly

