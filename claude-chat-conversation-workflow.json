{
  "name": "Claude API Conversation (Multi-turn)",
  "nodes": [
    {
      "parameters": {
        "path": "claude-chat",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger-001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "claude-chat-webhook"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "userMessage",
              "value": "={{ $json.body.message || 'Cześć!' }}"
            },
            {
              "name": "conversationHistory",
              "value": "={{ $json.body.history || '[]' }}"
            }
          ]
        }
      },
      "id": "set-input-002",
      "name": "Set Input",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.3,
      "position": [450, 300]
    },
    {
      "parameters": {
        "jsCode": "// Przygotuj historię konwersacji\nconst userMessage = $json.userMessage;\nlet history = [];\n\ntry {\n  history = JSON.parse($json.conversationHistory);\n} catch (e) {\n  history = [];\n}\n\n// Dodaj nową wiadomość użytkownika\nhistory.push({\n  role: \"user\",\n  content: userMessage\n});\n\n// Ogranicz historię do ostatnich 10 wiadomości\nif (history.length > 10) {\n  history = history.slice(-10);\n}\n\nreturn {\n  messages: history,\n  apiKey: $env.ANTHROPIC_API_KEY || 'your-api-key-here'\n};"
      },
      "id": "prepare-messages-003",
      "name": "Prepare Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $json.apiKey }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"claude-3-5-sonnet-20241022\",\n  \"max_tokens\": 2048,\n  \"messages\": {{ JSON.stringify($json.messages) }}\n}",
        "options": {}
      },
      "id": "call-claude-004",
      "name": "Call Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "jsCode": "// Wyciągnij odpowiedź i zaktualizuj historię\nconst response = $input.first().json;\nconst claudeMessage = response.content[0].text;\nconst previousMessages = $node[\"Prepare Messages\"].json.messages;\n\n// Dodaj odpowiedź Claude do historii\npreviousMessages.push({\n  role: \"assistant\",\n  content: claudeMessage\n});\n\nreturn {\n  response: claudeMessage,\n  conversationHistory: previousMessages,\n  usage: response.usage,\n  model: response.model\n};"
      },
      "id": "format-response-005",
      "name": "Format Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\n  \"message\": \"{{ $json.response }}\",\n  \"history\": {{ JSON.stringify($json.conversationHistory) }},\n  \"usage\": {{ JSON.stringify($json.usage) }},\n  \"model\": \"{{ $json.model }}\"\n}",
        "options": {}
      },
      "id": "respond-webhook-006",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1250, 300]
    }
  ],
